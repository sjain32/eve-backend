{
  "info": {
    "name": "Eve Platform — Full Test Suite",
    "_postman_id": "eve-platform-v2",
    "description": "Complete end-to-end test suite.\n\nA timestamp suffix (ts) is generated once at collection level so every run uses unique emails, centre names and test names — safe to re-run as many times as needed without hitting duplicate errors.\n\nRun order: Centre Head setup (01–20) → Patient flow (21–35) → Webhook tests (36–39) → Centre Head bookings view (40–42) → Edge cases (43–54)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate a unique timestamp suffix ONCE for the whole collection run.",
          "// Every request body that needs unique values uses {{ts}} via environment.",
          "if (!pm.environment.get('ts')) {",
          "  const ts = Date.now().toString();",
          "  pm.environment.set('ts', ts);",
          "}"
        ]
      }
    }
  ],
  "item": [

    {
      "name": "── CENTRE HEAD FLOW ──",
      "item": [

        {
          "name": "01 · Register Centre Head",
          "event": [{
            "listen": "prerequest",
            "script": { "type": "text/javascript", "exec": [
              "const ts = pm.environment.get('ts') || Date.now().toString();",
              "pm.environment.set('ts', ts);",
              "pm.environment.set('chEmail', `ch_${ts}@eve.test`);",
              "pm.environment.set('chName', `Dr Head ${ts}`);"
            ]}
          }, {
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.environment.set('centreHeadToken', r.accessToken);",
              "pm.environment.set('refreshToken', r.refreshToken);",
              "pm.test('Got access token', () => pm.expect(r.accessToken).to.be.a('string'));",
              "pm.test('Role is CENTRE_HEAD', () => pm.expect(r.user.role).to.eql('CENTRE_HEAD'));"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{chName}}\",\n  \"email\": \"{{chEmail}}\",\n  \"password\": \"CentreHead@1\",\n  \"role\": \"CENTRE_HEAD\"\n}" }
          }
        },

        {
