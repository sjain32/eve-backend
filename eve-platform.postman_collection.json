              "pm.environment.set('centreHeadToken', r.accessToken);",
              "pm.environment.set('refreshToken', r.refreshToken);",
              "pm.test('Role is CENTRE_HEAD', () => pm.expect(r.user.role).to.eql('CENTRE_HEAD'));"
            ]}
