# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
# Local PostgreSQL (docker-compose):
#   DATABASE_URL="postgresql://eve:eve_secret@localhost:5432/eve_db?schema=public"
# Neon / hosted PostgreSQL:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eve_db?schema=public"

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ── Bcrypt ────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug
